# Copy to .env and change values: cp .env.example .env

# PostgreSQL Database
POSTGRES_USER=transcendence
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcendence

# Backend Server
NODE_ENV=production
BACKEND_PORT=3000

# Authentication (JWT)
JWT_SECRET=change_me_to_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://192.168.1.192:1026/api/auth/google/callback
